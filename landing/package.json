{
  "name": "@svtrip/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SVTrip public landing page — prerendered to static HTML",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr prerender.ts --outDir dist-ssr && node dist-ssr/prerender.js",
    "preview": "vite preview",
    "serve": "tsx server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@svtrip/core": "*",
    "@svtrip/shared": "*",
    "express": "^4.21.1",
    "i18next": "^23.16.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.4"
  }
}
