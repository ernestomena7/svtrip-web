# SPA routing for shared hosting (feature 007 — FR-046).
#
# The desktop app is a single-page application: `/place/el-tunco` is a client
# route, not a file on disk. Apache looks for that file, does not find it, and
# returns 404 — so every shared link and every page reload appears broken while
# the app itself is fine.
#
# NO `RewriteBase` on purpose. Without it a relative substitution resolves
# against the directory this file sits in, so the SAME file works whether the app
# is served from the domain root (app.svtrip.com) or a subdirectory
# (svtrip.com/app). Hardcoding a base is how this file silently stops working the
# day the deployment layout changes.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Real files and directories are served as-is (assets, images, .well-known).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is handed to the app to route.
  RewriteRule . index.html [L]
</IfModule>

# Fingerprinted assets are immutable; the HTML must never be cached, or a
# visitor keeps the old app after a deploy and cannot be told otherwise.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
