# SPA routing for shared hosting (feature 007 — FR-046).
#
# The desktop app is a single-page application: `/place/el-tunco` is a client
# route, not a file on disk. Apache looks for that file, does not find it, and
# returns 404 — so every shared link and every page reload appears broken while
# the app itself is fine.
#
# NO `RewriteBase` on purpose. Without it a relative substitution resolves
# against the directory this file sits in, so the SAME file works whether the app
# is served from the domain root (app.svtrip.com) or a subdirectory
# (svtrip.com/app). Hardcoding a base is how this file silently stops working the
# day the deployment layout changes.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Real files and directories are served as-is (assets, images, .well-known).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is handed to the app to route.
  RewriteRule . index.html [L]
</IfModule>

# Caching. The HTML must never be cached, or a visitor keeps the old app after a
# deploy and cannot be told otherwise.
#
# Only FINGERPRINTED files may be immutable, and those live in `assets/` — that
# folder has its own .htaccess with the one-year rule. Files at this level
# (svtrip-wordmark.png, brand/*) keep the same name when their content changes,
# so a year of `immutable` here meant a new logo would not reach a returning
# visitor for a year. They get a day instead.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Security headers (2026-11-26, after Hostinger's scan). `always` so the 403/404 pages carry them too.
# HSTS has NO includeSubDomains on purpose: mail.* and other subdomains are not this deployment's to pin.
# No Content-Security-Policy yet: this page loads Google Fonts, map tiles, Supabase and the BFF, and a
# CSP written without measuring all of them would break the page — it is its own piece of work.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
</IfModule>
