# ==========================================================================
# svtrip-web environment configuration. Copy to .env and fill in, or set these
# as build-time environment variables in Hostinger's deploy configuration.
#
# Everything here is PUBLIC by design: this repo builds two static sites, and
# whatever lands in these variables ends up inside the shipped JS bundle where
# any visitor can read it. Nothing secret (API keys with write access, service
# credentials) belongs here — those live only on the BFF (Cloud Run), which is
# a separate deployment this repo does not include.
# ==========================================================================

# ---- Firebase (public web config — safe to ship) ----
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=svtrip-a7859.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=svtrip-a7859
VITE_FIREBASE_STORAGE_BUCKET=svtrip-a7859.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
VITE_USE_EMULATORS=0

# ---- The BFF (Cloud Run) ----
VITE_BFF_BASE_URL=https://svtrip-api-351085207141.us-central1.run.app/api

# ---- Map tiles for the business location picker (web/). Keyless by design —
# this is a URL, not a credential. ----
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright

# ---- landing/ only ----
# Where the landing's sign-in / CTA buttons point. Set to wherever web/ is
# deployed — a subdomain (https://app.svtrip.com) or a subdirectory
# (https://svtrip.com/app). See web/vite.config.ts's APP_BASE_PATH for the
# matching build-time setting on the web/ side.
VITE_APP_SIGN_IN_URL=https://app.svtrip.com/sign-in
VITE_APP_URL=https://app.svtrip.com
# Canonical domain, used for the prerendered <link rel="canonical"> and
# og:url / twitter: metadata.
LANDING_SITE_URL=https://svtrip.com

# ---- web/ only ----
# Where signing out sends a visitor. The mirror of VITE_APP_SIGN_IN_URL above:
# the landing links into the app, this links back out. Read at RUNTIME.
VITE_LANDING_URL=https://svtrip.com

# `/` for a subdomain deployment, `/app/` for a subdirectory deployment.
# See web/vite.config.ts — this is read at BUILD time, not runtime, because
# asset URLs are baked into the built HTML.
#
#   APP_BASE_PATH=/app/  npm run build --workspace web
#
# ⚠️ On Windows, set this from PowerShell or CMD, not Git Bash — Git Bash
# rewrites "/app/" into a Windows filesystem path and the build silently
# produces broken asset URLs.
# APP_BASE_PATH=/
